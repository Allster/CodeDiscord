# From the Discord Developer Portal → your application
DISCORD_TOKEN=
CLIENT_ID=

# Your studio's server ID (right-click the server icon → Copy Server ID, with Developer Mode on)
GUILD_ID=

# Optional: Discord user IDs that can always use admin commands, comma separated
OWNER_IDS=

# Optional: where the data file is kept. On Railway, mount a volume at /data and set this to /data
DATA_DIR=./data

# Optional: set to false to stay in other servers (but ignore them) instead of leaving
LEAVE_OTHER_GUILDS=true
